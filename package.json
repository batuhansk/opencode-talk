{
  "name": "opencode-talk",
  "version": "0.1.1",
  "description": "Talk instead of type in OpenCode. Zero-download, on-device speech-to-text using the speech engine built into macOS.",
  "keywords": [
    "opencode",
    "plugin",
    "speech-to-text",
    "stt",
    "voice",
    "dictation",
    "macos",
    "opencode-v2"
  ],
  "license": "MIT",
  "author": "Batuhan Saka (https://github.com/batuhansk)",
  "homepage": "https://github.com/batuhansk/opencode-talk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batuhansk/opencode-talk.git"
  },
  "bugs": {
    "url": "https://github.com/batuhansk/opencode-talk/issues"
  },
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./tui.js"
    }
  },
  "files": [
    "tui.js",
    "lib",
    "bin/opencode-talk-helper"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "sh scripts/build-helper.sh",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build && npm test",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2"
  }
}
